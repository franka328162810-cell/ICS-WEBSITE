        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return String(text).replace(/[&<>\"']/g, m => map[m]);
        }

        function renderSearchResults(results, query, filter) {
            const container = document.getElementById('searchResults');
            if (!container) return;

            if (results.length === 0) {
                container.innerHTML = `<div class="search-empty">No matching content found. Try: AI Governance, Ethics, Space Governance.</div>`;
                container.classList.add('active');
                return;
            }

            const header = `<div class="search-empty">${results.length} result(s) ${query ? `for "${escapeHtml(query)}"` : ''} ${filter !== 'all' ? `(category: ${escapeHtml(filter)})` : ''}</div>`;
